{
  "name": "dsh-console-workspace",
  "version": "0.0.0",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cofy-x/dsh-console.git"
  },
  "scripts": {
    "start": "node apps/cli/bin/dsh-console.js",
    "build-start:cli": "pnpm run build:cli && pnpm run start",
    "debug": "cross-env DEBUG=1 node --inspect-brk scripts/start.js",
    "lint": "eslint . --cache --max-warnings=0",
    "lint:fix": "eslint . --fix --ext .ts,.tsx && pnpm run format",
    "test": "pnpm -r run test",
    "test:ci": "pnpm -r run test:ci && pnpm --filter '@cofy-x/dsh-console' run test:performance",
    "test:integration:dsh": "node scripts/test-dsh-integration.mjs",
    "test:package": "node scripts/test-package-install.mjs",
    "format": "prettier --experimental-cli --write .",
    "typecheck": "pnpm run generate && pnpm --filter '@cofy-x/dsh-console-test-utils' run build && pnpm --filter '@cofy-x/dsh-console-core' run build && pnpm -r --if-present run typecheck",
    "preflight": "pnpm run clean && pnpm install --frozen-lockfile && pnpm run format && pnpm run build && pnpm run lint && pnpm run typecheck && pnpm run test:ci",
    "generate": "pnpm run generate:git-commit-info",
    "generate:git-commit-info": "node scripts/generate-git-commit-info.js",
    "sync:pokefetch-assets": "node scripts/sync-pokefetch-assets.mjs",
    "docs:dev": "pnpm --filter '@cofy-x/dsh-console-docs' run dev",
    "docs:check": "pnpm --filter '@cofy-x/dsh-console-docs' run check:content",
    "docs:build": "pnpm --filter '@cofy-x/dsh-console-docs' run build",
    "docs:verify": "pnpm --filter '@cofy-x/dsh-console-docs' run verify",
    "docs:social-card": "pnpm --filter '@cofy-x/dsh-console-docs' run generate:social-card",
    "build": "node scripts/build.js",
    "build:force": "cross-env FORCE_BUILD=true node scripts/build.js",
    "build:clean": "pnpm run clean && pnpm run build",
    "build-and-start": "pnpm run build && pnpm run start",
    "build:cli": "pnpm --filter '@cofy-x/dsh-console-core' run build && pnpm --filter '@cofy-x/dsh-console' run build",
    "dsh-console": "pnpm run build:cli && node apps/cli/bin/dsh-console.js",
    "build:core": "pnpm --filter '@cofy-x/dsh-console-core' run build",
    "clean": "node scripts/clean.js",
    "cli:link": "pnpm --filter '@cofy-x/dsh-console' run link",
    "cli:unlink": "pnpm --filter '@cofy-x/dsh-console' run unlink"
  },
  "devDependencies": {
    "@cofy-x/dsh-console-core": "workspace:*",
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "@types/yargs": "^17.0.34",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-headers": "^1.3.4",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.7.3",
    "strip-json-comments": "^5.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "yargs": "^18.0.0"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "1.1.0",
    "@lydell/node-pty-darwin-arm64": "1.1.0",
    "@lydell/node-pty-darwin-x64": "1.1.0",
    "@lydell/node-pty-linux-x64": "1.1.0",
    "@lydell/node-pty-win32-arm64": "1.1.0",
    "@lydell/node-pty-win32-x64": "1.1.0",
    "node-pty": "^1.0.0"
  },
  "description": "Private workspace for DSH Console development."
}
