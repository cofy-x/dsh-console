{
  "name": "@cofy-x/dsh-console-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Official DSH Console documentation website.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cofy-x/dsh-console.git",
    "directory": "apps/docs"
  },
  "homepage": "https://dsh-console.cofy-x.space",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "tsc --noEmit",
    "check:content": "pnpm run check && pnpm run lint:markdown && pnpm run check:social-card && pnpm run check:assets",
    "check:links": "node scripts/check-built-links.mjs",
    "check:social-card": "node scripts/generate-social-card.mjs --check",
    "check:assets": "node scripts/check-assets.mjs",
    "generate:social-card": "node scripts/generate-social-card.mjs",
    "lint:markdown": "markdownlint-cli2 \"README.md\" \"AGENTS.md\" \"src/content/docs/**/*.md\"",
    "test": "pnpm run check:content",
    "lint": "pnpm run check:content",
    "verify": "pnpm run check:content && pnpm run build && pnpm run check:links",
    "deploy": "wrangler pages deploy dist"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/starlight": "0.41.5",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "astro": "7.1.4",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "markdownlint-cli2": "0.23.2",
    "typescript": "5.9.3",
    "wrangler": "4.126.0"
  }
}
